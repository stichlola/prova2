# Copia questo file in ".env" e scegli una password robusta (almeno 10 caratteri).
# Il file .env NON va mai caricato su GitHub (è già escluso da .gitignore).
ADMIN_PASSWORD=
# Porta del server (facoltativa)
PORT=3000
# Cartella dei dati (facoltativa). In hosting puntala al disco persistente, es. /var/data
# DATA_DIR=
